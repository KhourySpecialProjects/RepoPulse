# Copy this file to .env and fill in your values
# cp .env.example .env

# Database (auto-configured for Docker Compose — change only if using external Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/repopulse
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/repopulse_test

# Auth
SECRET_KEY=dev-secret-key-change-in-production
AUTH_MODE=dev   # dev | prod

# Repository storage — host path that gets bind-mounted into the backend container
# Local clones live under: {REPO_ROOT_DIR}/{collection_folder}/{repo_name}/
REPO_ROOT_DIR=./seed-repos

# Anthropic — required only for AI summary features
ANTHROPIC_API_KEY=

# GitHub — required for private repos; create a classic token with `repo` scope
# https://github.com/settings/tokens
GITHUB_TOKEN=
