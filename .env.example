# Copy this file to .env and fill in your values
# cp .env.example .env

# Database (auto-configured for Docker Compose — change only if using external Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/repopulse
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/repopulse_test

# Auth
SECRET_KEY=dev-secret-key-change-in-production
AUTH_MODE=dev   # dev | prod

# Repository storage — the CONTAINER-side path, read by the backend from inside
# the container. It must match the right-hand side of the repos bind mount in
# docker-compose.yml (./seed-repos:/repos); the host path is set there, not here.
# Must be absolute: a relative value resolves against /app instead of the mount,
# so clones land outside it and are lost on rebuild. The backend refuses to
# start on a relative path rather than fail silently.
# Local clones live under: {REPO_ROOT_DIR}/{collection_folder}/{repo_name}/
REPO_ROOT_DIR=/repos

# Anthropic — required only for AI summary features
ANTHROPIC_API_KEY=

# GitHub — required for private repos; create a classic token with `repo` scope
# https://github.com/settings/tokens
GITHUB_TOKEN=
